# Backend Environment Variables
# Copy this to .env and fill in your values

# Required: Gemini AI API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Required: MongoDB connection string
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=vyapari_voice

# CORS — set to your frontend URL (Vercel URL in production)
FRONTEND_URL=http://localhost:5173

# Server
HOST=0.0.0.0
PORT=8000

# Environment: development | production
ENVIRONMENT=development

# Session TTL in seconds (pending voice actions expire after this)
SESSION_TTL_SECONDS=300
